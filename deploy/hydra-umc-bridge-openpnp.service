# The bridge coordinates a pick-and-place cell and only simulates a job; it never moves a machine. The configuration is
# /etc/hydra-umc-bridge-openpnp/bridge-openpnp.toml (example: deploy/bridge-openpnp.example.toml); the MQTT credentials go in
# /etc/hydra-umc-bridge-openpnp/bridge-openpnp.env (HYDRA_MQTT_USERNAME=..., readable by root only).
# Not installed by any installer yet, and not tried on a machine.
[Unit]
Description=HYDRA-UMC-BRIDGE-OPENPNP pick-and-place cell coordination
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-bridge-openpnp
Group=hydra-umc-bridge-openpnp
SupplementaryGroups=gpio
WorkingDirectory=/opt/hydra-umc/bridge-openpnp
Environment=PYTHONPATH=/opt/hydra-umc/bridge-openpnp/src:/opt/hydra-umc/sdk-python
EnvironmentFile=-/etc/hydra-umc-bridge-openpnp/bridge-openpnp.env
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_openpnp --check
ExecStart=/usr/bin/python3 -m hydra_umc_bridge_openpnp
Restart=on-failure
RestartSec=5
StateDirectory=hydra-umc-bridge-openpnp
ConfigurationDirectory=hydra-umc-bridge-openpnp
ConfigurationDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# the GPIO chip is the only device it can need
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=192M

[Install]
WantedBy=multi-user.target
